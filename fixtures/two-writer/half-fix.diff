diff -ruN a/test/sdk-writer.test.mjs b/test/sdk-writer.test.mjs
--- a/test/sdk-writer.test.mjs	1970-01-01 08:00:00
+++ b/test/sdk-writer.test.mjs	2026-09-23 21:38:10
@@ -0,0 +1,12 @@
