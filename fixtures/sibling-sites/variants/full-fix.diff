diff --git a/test/litellm.test.mjs b/test/litellm.test.mjs
new file mode 100644
index 0000000..713e9ba
--- /dev/null
+++ b/test/litellm.test.mjs
@@ -0,0 +1,12 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { settleLitellm } from '../src/billing/providers/litellm.mjs';
+
+test('litellm: an unmeasured cost is stored as null, not 0', () => {
+  const db = []; settleLitellm(db, { model: 'M', usage: { prompt_tokens: 5 } });
+  assert.equal(db[0].cost, null);
+});
+test('litellm: a measured cost is kept, including 0', () => {
+  const db = []; settleLitellm(db, { model: 'M', cost: 0, usage: { prompt_tokens: 5 } });
+  assert.equal(db[0].cost, 0);
+});
diff --git a/test/sdk-writer.test.mjs b/test/sdk-writer.test.mjs
new file mode 100644
index 0000000..2324af0
--- /dev/null
+++ b/test/sdk-writer.test.mjs
@@ -0,0 +1,12 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { writeSdkUsage } from '../src/usage/sdk-writer.mjs';
+
+test('sdk: an unmeasured cost is stored as null, not 0', () => {
+  const db = []; writeSdkUsage(db, { model: 'm', input_tokens: 10 });
+  assert.equal(db[0].cost, null);
+});
+test('sdk: a measured cost is kept', () => {
+  const db = []; writeSdkUsage(db, { model: 'm', input_tokens: 10, cost: 3 });
+  assert.equal(db[0].cost, 3);
+});
